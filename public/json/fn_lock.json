{
  "title": "Fn Lock: toggle function-key mode with Fn+Esc",
  "rules": [
    {
      "description": "Fn+Esc toggles Fn Lock for the top row",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "fn",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "fn",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "key_code": "fn"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_unless",
              "name": "fn_lock",
              "value": 1
            }
          ],
          "from": {
            "key_code": "escape",
            "modifiers": {
              "mandatory": [
                "fn"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_notification_message": {
                "id": "fn_lock_status",
                "text": "Fn Lock On",
                "duration_milliseconds": 800
              }
            },
            {
              "set_variable": {
                "name": "fn_lock",
                "value": 1
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "fn_lock",
              "value": 1
            }
          ],
          "from": {
            "key_code": "escape",
            "modifiers": {
              "mandatory": [
                "fn"
              ],
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_notification_message": {
                "id": "fn_lock_status",
                "text": "Fn Lock Off",
                "duration_milliseconds": 800
              }
            },
            {
              "set_variable": {
                "name": "fn_lock",
                "value": 0
              }
            }
          ]
        },
        {
